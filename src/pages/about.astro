---
import { getImage } from 'astro:assets'
import LayoutAbout from '~/layouts/LayoutAbout.astro'
import { packBento } from '~/components/about/bento'
import {
  book,
  earlierJobs,
  featured,
  iosApps,
  kryptogo,
  macApps,
  stats,
  webWorks,
  workCategories,
  writing,
} from '~/components/about/data'

const pad = (n: number) => String(n).padStart(2, '0')

const categoryName = Object.fromEntries(workCategories.map((c) => [c.id, c.name]))
const works = await Promise.all(
  webWorks.map(async (work) => ({
    ...work,
    href: work.path.startsWith('http') ? work.path : `https://dweam.xyz${work.path}`,
    preview: (await getImage({ src: work.image, width: 800, format: 'webp' })).src,
  })),
)
const hot = works.filter((w) => w.categories.includes('personal'))
// bento 格子形狀先照桌機 6 欄排；motion.ts 依實際欄數與分類重排
const hotShapes = packBento(
  hot.map((w) => !!w.featured),
  6,
)
const shapeOf = (w: (typeof works)[number]) => hotShapes[hot.indexOf(w)] ?? ''

const jobs = [
  {
    company: kryptogo.company,
    role: kryptogo.role,
    period: kryptogo.period,
    logo: kryptogo.logo,
    summary: kryptogo.summary,
  },
  ...earlierJobs,
]
---

<LayoutAbout>
  <!-- 01 Hero -->
  <section class="hero shell">
    <div class="hero-meta mono">
      <span>About</span>
      <a href="mailto:doraralab@gmail.com">doraralab@gmail.com</a>
      <a href="https://www.threads.net/@dorara_hsieh" target="_blank">@dorara_hsieh</a>
    </div>

    <div class="hero-main">
      <h1 class="hero-name" data-hero-name>Dorara</h1>
      <div class="hero-avatar" id="avatarContainer" aria-hidden="true"></div>
    </div>

    <div class="hero-foot">
      <p class="mono hero-role" data-hero-fade>Flutter Lead &amp; Full Stack Developer</p>
      <div class="hero-intro" data-hero-lines>
        <p>我相信<em>好的產品來自於對細節的執著</em>。從架構設計到使用者體驗，每一個環節都值得被認真對待。</p>
        <p>
          作為一個 <em>Builder</em
          >，我不只是寫程式，更喜歡從零到一打造完整的產品。在工作之餘，我持續經營個人專案，將有趣的想法分享給大家。
        </p>
      </div>
    </div>
  </section>

  <!-- 02 Builder -->
  <section class="block shell">
    <header class="sec-head mono">
      <span>02</span><span>2025 Builder 計畫</span><span>獨立開發者 / Creator</span><span>2025 — Present</span>
    </header>

    <h2 class="statement" data-reveal-lines>
      <span class="ln"><span>一個人，</span></span><span class="ln"><span>打造完整的產品。</span></span>
    </h2>
    <p class="statement-sub" data-reveal>
      在 Threads 經營個人的 Builder 社群，「一個人」打造網頁和 APP 製作實驗性的產品，精進產品能力。
    </p>

    <div class="ledger">
      {
        stats.map((s) => {
          const Tag = s.href ? 'a' : 'div'
          return (
            <Tag class="ledger-cell" href={s.href} target={s.href ? '_blank' : undefined} data-ledger>
              <span class="ledger-value">{s.value}</span>
              <span class="mono ledger-label">
                {s.label}
                {s.note && <span> · {s.note}</span>}
                {s.href && <span aria-hidden="true"> ↗</span>}
              </span>
            </Tag>
          )
        })
      }
    </div>
  </section>

  <!-- 03 Featured -->
  <section class="block shell">
    <header class="sec-head mono"><span>03</span><span>Featured</span></header>

    <div class="plates">
      {
        featured.map((f) => (
          <a href={f.path} target="_blank" class="plate" data-tint={f.tint}>
            <div class="plate-frame" data-plate>
              <img src={f.image.src} alt={f.title} width={f.image.width} height={f.image.height} loading="lazy" />
            </div>
            <div class="plate-caption">
              <div class="plate-head">
                <h3 class="plate-name">{f.title}</h3>
                <span class="mono plate-type">{f.type}</span>
                <span class="plate-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
              <p class="plate-tagline">{f.tagline}</p>
              <p class="plate-desc">{f.description}</p>
              <p class="mono plate-tags">{f.tags.join(' · ')}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 04 Mobile：左邊選 app，右邊一手牌 -->
  <section class="block shell" data-phones>
    <header class="sec-head mono"><span>04</span><span>Mobile App</span><span>App Store</span></header>

    <div class="phones">
      <ol class="phones-list">
        {
          iosApps.map((app, i) => (
            <li>
              <button
                type="button"
                class:list={['phones-tab', { 'is-active': i === 0 }]}
                data-phone-tab={i}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <img src={app.icon.src} alt="" width="52" height="52" />
                <span class="phones-tab-text">
                  <span class="phones-name">{app.title}</span>
                  <span class="phones-desc">{app.description}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ol>

      <div class="phones-deck">
        {
          iosApps.map((app, i) => (
            <a
              href={app.path}
              target="_blank"
              class:list={['phones-hand', { 'is-active': i === 0 }]}
              data-phone-hand
              data-tint={app.tint}
              aria-label={`${app.title} on the App Store`}
            >
              {app.shots.length > 0 ? (
                app.shots.map((shot) => (
                  <img
                    class="phones-card"
                    src={shot.src}
                    alt=""
                    width={shot.width}
                    height={shot.height}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                ))
              ) : (
                <img class="phones-solo" src={app.icon.src} alt="" width="200" height="200" loading="lazy" />
              )}
              <span class="mono phones-store">App Store ↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 05 Mac -->
  <section class="stage" data-stage>
    <div class="stage-inner shell">
      <header class="sec-head mono">
        <span>05</span><span>Mac App</span><span class="stage-count"
          ><span data-stage-current>01</span> / {pad(macApps.length)}</span
        >
      </header>

      <div class="stage-grid">
        <ol class="stage-list">
          {
            macApps.map((app, i) => (
              <li>
                <button type="button" class:list={['stage-row', { 'is-active': i === 0 }]} data-stage-row={i}>
                  <span class="mono">{pad(i + 1)}</span>
                  {app.title}
                </button>
              </li>
            ))
          }
        </ol>

        <div class="stage-frames">
          {
            macApps.map((app, i) => (
              <a
                href={app.path}
                target="_blank"
                class:list={['stage-frame', { 'is-active': i === 0 }]}
                data-stage-frame
                data-tint={app.stage}
                style={`--frame-bg: ${app.stage}`}
              >
                <div class="stage-mock">
                  <img
                    src={app.mock.src}
                    alt=""
                    width={app.mock.width}
                    height={app.mock.height}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
                <div class="stage-caption">
                  <img src={app.icon.src} alt="" class="stage-icon" width="56" height="56" loading="lazy" />
                  <div>
                    <h3 class="stage-name">{app.title}</h3>
                    <p class="stage-tagline">{app.tagline}</p>
                  </div>
                  <span class="plate-arrow" aria-hidden="true">
                    ↗
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 06 Web：作品是會撞牆的塊 -->
  <section class="block shell">
    <header class="sec-head mono">
      <span>06</span><span>Web 互動作品</span><span>(<span data-works-count>{pad(hot.length)}</span>)</span>
    </header>

    <div class="filters" role="tablist">
      {
        workCategories.map((c) => (
          <button
            type="button"
            role="tab"
            class:list={['filter', { 'is-active': c.id === 'personal' }]}
            aria-selected={c.id === 'personal' ? 'true' : 'false'}
            data-filter={c.id}
          >
            {c.name}
          </button>
        ))
      }
      <span class="filter-bar" aria-hidden="true"></span>
    </div>

    <div class="bento" data-bento>
      {
        works.map((w) => (
          <a
            href={w.href}
            target="_blank"
            class:list={['tile', shapeOf(w) && `is-${shapeOf(w)}`, { 'is-hidden': !w.categories.includes('personal') }]}
            data-categories={w.categories.join(' ')}
            data-featured={w.featured ? '' : undefined}
            data-tint={w.tint}
          >
            <span class="tile-media">
              <img src={w.preview} alt="" loading="lazy" />
            </span>
            <span class="tile-info">
              <span class="tile-title">{w.title}</span>
            </span>
            <span class="tile-more">
              <span class="tile-desc">{w.description}</span>
              <span class="mono tile-cat">
                {w.categories.map((c) => categoryName[c]).join(' / ')}
                <span aria-hidden="true">↗</span>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 07 Experience：一行一份工作，細節點開才看 -->
  <section class="block shell">
    <header class="sec-head mono"><span>07</span><span>Experience</span></header>

    <div class="jobs">
      {
        jobs.map((job, j) => (
          <details class="job" data-reveal>
            <summary class="job-row">
              <span class="mono job-period">{job.period}</span>
              <span class="job-main">
                <span class="job-company">
                  {job.logo && <img src={job.logo.src} alt="" width="22" height="22" />}
                  {job.company}
                </span>
                <span class="job-role">{job.role}</span>
              </span>
              <span class="job-summary">{job.summary}</span>
              <span class="job-toggle" aria-hidden="true" />
            </summary>

            <div class="job-body">
              {j === 0 ? (
                <div class="job-blocks">
                  {kryptogo.blocks.map((b, i) => (
                    <div class="job-block">
                      <p class="mono">{pad(i + 1)}</p>
                      <h4 class="job-title">{b.title}</h4>
                      {b.practice && <p>{b.practice}</p>}
                      {(b.outcomes ?? b.items) && (
                        <ul class={b.outcomes ? 'job-outcomes' : 'job-list'}>
                          {(b.outcomes ?? b.items)!.map((o) => (
                            <li>{o}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                <div class="job-blocks">
                  {earlierJobs[j - 1].groups.map((g) => (
                    <div class="job-block">
                      {g.title && <h4 class="job-title">{g.title}</h4>}
                      <p>{g.lead}</p>
                      {g.items.length > 0 && (
                        <ul class="job-list">
                          {g.items.map((o) => (
                            <li>{o}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <!-- 08 Writing -->
  <section class="block shell">
    <header class="sec-head mono"><span>08</span><span>技術寫作 &amp; 出版</span></header>

    <a href={book.path} target="_blank" class="book" data-tint="#9db8dd">
      <div class="book-cover" data-reveal>
        <img src={book.cover.src} alt={book.title} width={book.cover.width} height={book.cover.height} loading="lazy" />
      </div>
      <div class="book-info" data-reveal>
        <p class="mono">{book.publisher} · {book.date}</p>
        <h3 class="book-title">{book.title}</h3>
        <p class="book-sub">{book.subtitle}</p>
        <p class="book-authors">{book.authors}</p>
        <p class="mono book-note">{book.note}</p>
        <span class="book-buy">
          <span>博客來購買</span>
          <span aria-hidden="true">↗</span>
        </span>
        <span class="mono book-url">books.com.tw/products/0011008795</span>
      </div>
    </a>

    <ul class="index">
      {
        writing.map((w) => (
          <li class="index-item" data-reveal>
            <a href={w.path} target="_blank" class="index-row">
              <span class="index-title">{w.title}</span>
              <span class="index-desc">{w.description}</span>
              <span class="mono index-cat">{w.host}</span>
              <span class="index-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <footer class="contact shell">
    <p class="mono">Say hi</p>
    <a href="mailto:doraralab@gmail.com" class="contact-mail">doraralab@gmail.com</a>
    <div class="contact-foot mono">
      <a href="https://www.threads.net/@dorara_hsieh" target="_blank">Threads ↗</a>
      <span>© {new Date().getFullYear()} Dorara Hsieh</span>
    </div>
  </footer>

  <script>
    import { initAbout } from '~/components/about/motion'

    initAbout()
  </script>
</LayoutAbout>
