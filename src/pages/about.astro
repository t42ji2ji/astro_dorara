---
import { getImage } from 'astro:assets'
import LayoutAbout from '~/layouts/LayoutAbout.astro'
import {
  earlierJobs,
  featured,
  iosApps,
  kryptogo,
  macApps,
  stats,
  webWorks,
  workCategories,
  writing,
} from '~/components/about/data'

const pad = (n: number) => String(n).padStart(2, '0')
const categoryName = Object.fromEntries(workCategories.map((c) => [c.id, c.name]))

const works = await Promise.all(
  webWorks.map(async (work, i) => ({
    ...work,
    no: pad(i + 1),
    href: work.path.startsWith('http') ? work.path : `https://dweam.xyz${work.path}`,
    preview: (await getImage({ src: work.image, width: 640, format: 'webp' })).src,
    thumb: (await getImage({ src: work.image, width: 160, format: 'webp' })).src,
  })),
)
const hotCount = works.filter((w) => w.categories.includes('personal')).length
---

<LayoutAbout>
  <!-- 01 Hero -->
  <section class="hero shell" data-section>
    <div class="hero-meta mono">
      <span>About</span>
      <a href="mailto:doraralab@gmail.com">doraralab@gmail.com</a>
      <a href="https://www.threads.net/@dorara_hsieh" target="_blank">@dorara_hsieh</a>
    </div>

    <div class="hero-main">
      <h1 class="hero-name" data-hero-name>Dorara</h1>
      <div class="hero-avatar" id="avatarContainer" aria-hidden="true"></div>
    </div>

    <div class="hero-foot">
      <p class="mono hero-role" data-hero-fade>Flutter Lead &amp; Full Stack Developer</p>
      <div class="hero-intro" data-hero-lines>
        <p>我相信<em>好的產品來自於對細節的執著</em>。從架構設計到使用者體驗，每一個環節都值得被認真對待。</p>
        <p>
          作為一個 <em>Builder</em
          >，我不只是寫程式，更喜歡從零到一打造完整的產品。在工作之餘，我持續經營個人專案，將有趣的想法分享給大家。
        </p>
      </div>
    </div>
  </section>

  <!-- 02 Experience -->
  <section class="block shell" data-section>
    <header class="sec-head mono"><span>02</span><span>Experience</span></header>

    <div class="exp">
      <div class="exp-rail" aria-hidden="true"><span data-rail></span></div>

      <article class="exp-item">
        <div class="exp-meta">
          <img src={kryptogo.logo.src} alt="" class="exp-logo" width="28" height="28" />
          <h3 class="exp-company">{kryptogo.company}</h3>
          <p class="exp-role">{kryptogo.role}</p>
          <p class="mono exp-period">{kryptogo.period}</p>
        </div>
        <div class="exp-body">
          <p class="exp-summary" data-reveal>{kryptogo.summary}</p>
          {
            kryptogo.blocks.map((b, i) => (
              <div class="exp-block" data-reveal>
                <p class="mono exp-no">{pad(i + 1)}</p>
                <h4 class="exp-title">{b.title}</h4>
                {b.practice && <p>{b.practice}</p>}
                {b.outcomes && (
                  <ul class="exp-outcomes">
                    {b.outcomes.map((o) => (
                      <li>{o}</li>
                    ))}
                  </ul>
                )}
                {b.items && (
                  <ul class="exp-list">
                    {b.items.map((o) => (
                      <li>{o}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))
          }
        </div>
      </article>

      {
        earlierJobs.map((job) => (
          <article class="exp-item">
            <div class="exp-meta">
              {job.logo && <img src={job.logo.src} alt="" class="exp-logo" width="28" height="28" />}
              <h3 class="exp-company">{job.company}</h3>
              <p class="exp-role">{job.role}</p>
              <p class="mono exp-period">{job.period}</p>
            </div>
            <div class="exp-body" data-reveal>
              {job.groups.map((g) => (
                <div class="exp-group">
                  {g.title && <h4 class="exp-title">{g.title}</h4>}
                  <p>{g.lead}</p>
                  {g.items.length > 0 && (
                    <ul class="exp-list">
                      {g.items.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 03 Builder -->
  <section class="block shell" data-section>
    <header class="sec-head mono"><span>03</span><span>2025 Builder 計畫</span><span>2025 — Present</span></header>

    <h2 class="statement" data-reveal-lines>
      <span class="ln"><span>一個人，</span></span><span class="ln"><span>打造完整的產品。</span></span>
    </h2>
    <p class="statement-sub" data-reveal>
      在 Threads 經營個人的 Builder 社群，「一個人」打造網頁和 APP 製作實驗性的產品，精進產品能力。
    </p>

    <div class="ledger">
      {
        stats.map((s) => {
          const Tag = s.href ? 'a' : 'div'
          return (
            <Tag class="ledger-cell" href={s.href} target={s.href ? '_blank' : undefined} data-ledger>
              <span class="ledger-value">{s.value}</span>
              <span class="mono ledger-label">
                {s.label}
                {s.note && <span> · {s.note}</span>}
                {s.href && <span aria-hidden="true"> ↗</span>}
              </span>
            </Tag>
          )
        })
      }
    </div>
  </section>

  <!-- 04 Featured -->
  <section class="block shell" data-section>
    <header class="sec-head mono"><span>04</span><span>Featured</span></header>

    <div class="plates">
      {
        featured.map((f) => (
          <a href={f.path} target="_blank" class="plate" data-tint={f.tint}>
            <div class="plate-frame" data-plate>
              <img src={f.image.src} alt={f.title} width={f.image.width} height={f.image.height} loading="lazy" />
            </div>
            <div class="plate-caption">
              <div class="plate-head">
                <h3 class="plate-name">{f.title}</h3>
                <span class="mono plate-type">{f.type}</span>
                <span class="plate-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
              <p class="plate-tagline">{f.tagline}</p>
              <p class="plate-desc">{f.description}</p>
              <p class="mono plate-tags">{f.tags.join(' · ')}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 05 iOS -->
  <section class="block shell" data-section>
    <header class="sec-head mono"><span>05</span><span>Mobile App</span></header>

    <ul class="dock">
      {
        iosApps.map((app) => (
          <li data-reveal>
            <a href={app.path} target="_blank" class="dock-app">
              <img src={app.icon.src} alt="" width="80" height="80" loading="lazy" />
              <span class="dock-name">{app.title}</span>
              <span class="dock-desc">{app.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 06 Mac -->
  <section class="stage" data-stage>
    <div class="stage-inner shell">
      <header class="sec-head mono">
        <span>06</span><span>Mac App</span><span class="stage-count"
          ><span data-stage-current>01</span> / {pad(macApps.length)}</span
        >
      </header>

      <div class="stage-grid">
        <ol class="stage-list">
          {
            macApps.map((app, i) => (
              <li>
                <button type="button" class:list={['stage-row', { 'is-active': i === 0 }]} data-stage-row={i}>
                  <span class="mono">{pad(i + 1)}</span>
                  {app.title}
                </button>
              </li>
            ))
          }
        </ol>

        <div class="stage-frames">
          {
            macApps.map((app, i) => (
              <a
                href={app.path}
                target="_blank"
                class:list={['stage-frame', { 'is-active': i === 0 }]}
                data-stage-frame
                data-tint={app.stage}
              >
                <div class="stage-mock">
                  <img
                    src={app.mock.src}
                    alt=""
                    width={app.mock.width}
                    height={app.mock.height}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
                <div class="stage-caption">
                  <img src={app.icon.src} alt="" class="stage-icon" width="56" height="56" loading="lazy" />
                  <div>
                    <h3 class="stage-name">{app.title}</h3>
                    <p class="stage-tagline">{app.tagline}</p>
                  </div>
                  <span class="plate-arrow" aria-hidden="true">
                    ↗
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 07 Web -->
  <section class="block shell" data-section>
    <header class="sec-head mono">
      <span>07</span><span>Web 互動作品</span><span>(<span data-works-count>{pad(hotCount)}</span>)</span>
    </header>

    <div class="filters" role="tablist">
      {
        workCategories.map((c) => (
          <button
            type="button"
            role="tab"
            class:list={['filter', { 'is-active': c.id === 'personal' }]}
            aria-selected={c.id === 'personal' ? 'true' : 'false'}
            data-filter={c.id}
          >
            {c.name}
          </button>
        ))
      }
      <span class="filter-bar" aria-hidden="true"></span>
    </div>

    <ul class="index" data-index>
      {
        works.map((w) => (
          <li
            class:list={['index-item', { 'is-hidden': !w.categories.includes('personal') }]}
            data-categories={w.categories.join(' ')}
          >
            <a href={w.href} target="_blank" class="index-row" data-preview={w.preview} data-tint={w.tint}>
              <span class="mono index-no">{w.no}</span>
              <span class="index-title">{w.title}</span>
              <span class="index-desc">{w.description}</span>
              <span class="mono index-cat">{w.categories.map((c) => categoryName[c]).join(' / ')}</span>
              <img class="index-thumb" src={w.thumb} alt="" width="72" height="45" loading="lazy" />
              <span class="index-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 08 Writing + contact -->
  <section class="block shell" data-section>
    <header class="sec-head mono"><span>08</span><span>技術寫作 &amp; 出版</span></header>

    <ul class="index index--static">
      {
        writing.map((w, i) => (
          <li class="index-item" data-reveal>
            <a href={w.path} target="_blank" class="index-row">
              <span class="mono index-no">{pad(i + 1)}</span>
              <span class="index-title">{w.title}</span>
              <span class="index-desc">{w.description}</span>
              <span class="mono index-cat">{w.host}</span>
              <span class="index-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <footer class="contact shell" data-section>
    <p class="mono">Say hi</p>
    <a href="mailto:doraralab@gmail.com" class="contact-mail">doraralab@gmail.com</a>
    <div class="contact-foot mono">
      <a href="https://www.threads.net/@dorara_hsieh" target="_blank">Threads ↗</a>
      <span>© {new Date().getFullYear()} Dorara Hsieh</span>
    </div>
  </footer>

  <div class="peek" aria-hidden="true"><img alt="" /></div>

  <script>
    import { initAbout } from '~/components/about/motion'

    initAbout()
  </script>
</LayoutAbout>
