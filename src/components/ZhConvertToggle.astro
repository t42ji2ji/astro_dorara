---
// Traditional/Simplified Chinese toggle for post content
---

<button
  id="zh-convert-toggle"
  type="button"
  aria-label="切換簡體繁體"
  class="not-prose zh-convert-btn text-xs px-2 py-1 rounded border border-stone-300 text-stone-500 bg-transparent cursor-pointer transition-colors hover:bg-stone-100 dark:border-stone-700 dark:text-stone-400 dark:hover:bg-stone-800"
>
  切換簡體
</button>

<script>
  import { Converter, HTMLConverter } from 'opencc-js/t2cn'

  // 明確表態的語言標籤，優先於任何地區推測
  const HANT_LANG = /^zh-(?:tw|hk|mo|hant)\b/i
  const HANS_LANG = /^zh-(?:cn|sg|my|hans)\b/i
  const ANY_ZH = /^zh\b/i

  // 時區作為地區訊號：不受 VPN 影響，也不需要額外請求
  const CN_TZ = /^(?:Asia\/(?:Shanghai|Chongqing|Chungking|Harbin|Urumqi|Kashgar)|PRC)$/
  const HANT_TZ = /^(?:Asia\/(?:Taipei|Hong_Kong|Macau)|ROC)$/

  function timeZone() {
    return Intl.DateTimeFormat().resolvedOptions().timeZone ?? ''
  }

  function prefersSimplified() {
    const langs = navigator.languages?.length ? navigator.languages : [navigator.language ?? '']

    for (const lang of langs) {
      if (HANT_LANG.test(lang)) {
        return false
      }
      if (HANS_LANG.test(lang)) {
        return true
      }
      // 裸 zh 沒有地區資訊，用時區決定；預設為簡體（CLDR 的 zh 預設是 Hans）
      if (ANY_ZH.test(lang)) {
        return !HANT_TZ.test(timeZone())
      }
    }

    // 非中文瀏覽器：只有在中國大陸時區才轉簡體
    return CN_TZ.test(timeZone())
  }

  function setupZhConvertToggle() {
    const btnEl = document.getElementById('zh-convert-toggle')
    const contentEl = document.querySelector<HTMLElement>('.post-content')

    if (!btnEl || !contentEl)
      return

    const btn: HTMLElement = btnEl
    const content: HTMLElement = contentEl

    const converter = Converter({ from: 'tw', to: 'cn' })
    const handler = HTMLConverter(converter, content, 'zh-tw', 'zh-cn')

    function isSimplified() {
      const stored = localStorage.getItem('zh-convert')
      if (stored)
        return stored === 'cn'
      return prefersSimplified()
    }

    function apply() {
      if (isSimplified()) {
        handler.convert()
        btn.textContent = '切換繁體'
      } else {
        handler.restore()
        btn.textContent = '切換簡體'
      }
    }

    btn.addEventListener('click', () => {
      localStorage.setItem('zh-convert', isSimplified() ? 'tw' : 'cn')
      apply()
    })

    apply()
  }

  setupZhConvertToggle()

  // Re-run after page transitions (for Swup)
  document.addEventListener('astro:after-swap', setupZhConvertToggle)
</script>
