---
import awayblurIcon from '~/assets/macapps/awayblur-icon.png'
import awayblurMock from '~/assets/macapps/awayblur-mock.png'
import meetrecIcon from '~/assets/macapps/meetrec-icon.png'
import meetrecMock from '~/assets/macapps/meetrec-mock.png'
import mailsiftIcon from '~/assets/macapps/mailsift-icon.png'
import mailsiftMock from '~/assets/macapps/mailsift-mock.png'
import draftIcon from '~/assets/macapps/draft-icon.png'
import draftMock from '~/assets/macapps/draft-mock.png'
import sonaIcon from '~/assets/macapps/sona-icon.png'
import sonaMock from '~/assets/macapps/sona-mock.png'
import rugIcon from '~/assets/macapps/rug-icon.png'
import rugMock from '~/assets/macapps/rug-mock.png'

const macApps = [
  {
    title: 'MeetRec',
    tagline: '會議錄音，分得出誰說了什麼',
    path: 'https://meetrec.dorara.app/',
    icon: meetrecIcon,
    mock: meetrecMock,
    stage: '#f3f2ee',
  },
  {
    title: 'MailSift',
    tagline: '用描述找信，信不離開這台 Mac',
    path: 'https://mailsift.dorara.app/',
    icon: mailsiftIcon,
    mock: mailsiftMock,
    stage: '#ececec',
  },
  {
    title: 'Draft',
    tagline: '打開就能寫，只亮著正在寫的那句',
    path: 'https://draft.dorara.app/',
    icon: draftIcon,
    mock: draftMock,
    stage: '#f6efdf',
  },
  {
    title: 'Sona',
    tagline: '在自己電腦上做歌、翻唱、拆軌',
    path: 'https://github.com/t42ji2ji/sona',
    icon: sonaIcon,
    mock: sonaMock,
    stage: '#140d1c',
  },
  {
    title: 'Away Blur',
    tagline: '人一離開，螢幕就糊成毛玻璃',
    path: 'https://awayblur.dorara.app/',
    icon: awayblurIcon,
    mock: awayblurMock,
    stage: '#f4f4f4',
  },
  {
    title: 'Desktop Rug',
    tagline: '鋪在桌面上的厚地毯，住著貓',
    path: 'https://rug.dorara.app/',
    icon: rugIcon,
    mock: rugMock,
    stage: '#f3e9dc',
  },
]
---

<h4 class="font-bold text-lg mb-4 mt-8">💻 Mac App</h4>

<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
  {
    macApps.map((app) => (
      <a href={app.path} target="_blank" class="mac-app-card">
        <div class="mac-app-stage" style={`background: ${app.stage}`}>
          <img src={app.mock.src} alt="" class="mac-app-mock" loading="lazy" />
        </div>
        <div class="mac-app-info">
          <img src={app.icon.src} alt={app.title} class="mac-app-icon" />
          <div class="min-w-0">
            <div class="mac-app-name">{app.title}</div>
            <div class="mac-app-tagline">{app.tagline}</div>
          </div>
        </div>
      </a>
    ))
  }
</div>

<style>
  .mac-app-card {
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--card-shadow);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mac-app-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--card-shadow-hover);
  }

  .mac-app-stage {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow: hidden;
  }

  .mac-app-mock {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 10px;
    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.12));
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mac-app-card:hover .mac-app-mock {
    transform: scale(1.03);
  }

  .mac-app-info {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
  }

  .mac-app-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    margin: 0;
  }

  .mac-app-name {
    font-weight: 600;
    font-size: 1rem;
  }

  .mac-app-tagline {
    font-size: 0.875rem;
    color: #666;
  }

  :global(.dark) .mac-app-tagline {
    color: #aaa;
  }
</style>
